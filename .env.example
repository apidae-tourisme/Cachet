# Configuration du docker-compose local. Copier ce fichier en `.env`
# (gitignoré — le repo est PUBLIC, aucune valeur réelle ne doit être commitée),
# docker compose le lit automatiquement.
# Les scripts de migration ont leur propre configuration : scripts/.env.example.
#
# NB : ce fichier ne configure PAS l'application Laravel déployée (elle est
# configurée par variables d'environnement, voir docker-compose.yml et DOCKER.md).

# APP_KEY Laravel de la prod (base64:...) — indispensable pour utiliser le
# back-office sur des données de prod importées. Ne JAMAIS la régénérer.
APP_KEY=

# Clés reCAPTCHA. Par défaut : clés de test publiques Google (la vérification
# passe toujours) — suffisant en local.
#GOOGLE_CAPTCHA_SITE=
#GOOGLE_CAPTCHA_SECRET=

# Port hôte de l'UI MailHog (si le défaut est déjà pris sur votre poste).
#MAILHOG_UI_PORT=8026
