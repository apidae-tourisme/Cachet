# Configuration des scripts de migration de base (import-prod-db.sh,
# restore-preprod-db.sh). Copier ce fichier en `scripts/.env` (gitignoré —
# le repo est PUBLIC, aucune valeur réelle ne doit être commitée).

# Accès SSH au serveur de prod actuel, forme user@host.
# Sert uniquement au dump de la base (lecture seule).
STATUS_PROD_SSH=

# Cible du restore préproduction (restore-preprod-db.sh) :
# namespace et service du cluster PostgreSQL partagé (voir apidae-sit-flux).
PREPROD_PG_NAMESPACE=
PREPROD_PG_SERVICE=

# Cible du restore production (restore-prod-db.sh, bascule jour J) :
# namespace et service du cluster PostgreSQL partagé côté production.
PROD_PG_NAMESPACE=
PROD_PG_SERVICE=
